# Copy this file to .env.local (dev) or set these as real environment
# variables / IIS web.config appSettings in production. Never commit the
# filled-in version — .env.local and .env.production are already gitignored.

# --- App ---
# Served under aitc.pvamu.edu/cafnr/ced-direct. This full URL is used to build
# the public survey links, so it must include the sub-path.
NEXT_PUBLIC_APP_URL=https://aitc.pvamu.edu/cafnr/ced-direct

# --- Sub-path hosting (IIS) ---
# Baked in at BUILD time (next.config reads it). Must match AUTH_URL's path,
# the web.config rewrite target, and the Entra redirect URI.
NEXT_PUBLIC_BASE_PATH=/cafnr/ced-direct
# Local port the Node process listens on (matches web.config + ecosystem).
PORT=3003

# --- Auth.js / NextAuth (used to sign & encrypt session cookies) ---
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Must include the /api/auth path (matches basePath in auth.ts) so Auth.js
# routes and the OAuth callback URL resolve under the sub-path.
AUTH_URL=https://aitc.pvamu.edu/cafnr/ced-direct/api/auth
AUTH_TRUST_HOST=true

# --- Azure AD / Microsoft Entra ID (SSO) ---
# Register an "App registration" in the Entra ID admin center, add a
# Web redirect URI of: <AUTH_URL>/api/auth/callback/azure-ad
# For local dev that's: http://localhost:3000/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# --- Azure SQL Database ---
AZURE_SQL_SERVER=ced-direct-sql.database.windows.net
AZURE_SQL_DATABASE=ced-direct
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
AZURE_SQL_PORT=1433
