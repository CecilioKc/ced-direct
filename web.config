<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse-proxy for CED-Direct (Next.js + Auth.js/Entra).
  Served at https://aitc.pvamu.edu/cafnr/ced-direct
  Node runs on 127.0.0.1:3003 under PM2; IIS reverse-proxies via ARR.

  Minimal rule on purpose: no <serverVariables> (IIS won't override the
  allow-list in a sub-application -> 500), and {UNENCODED_URL} forwards the path
  verbatim (avoids the trailing-slash redirect loop). Auth.js builds its own
  URLs from AUTH_URL, so X-Forwarded-* are not needed.

  Requires (server-level, one-time): URL Rewrite + ARR with proxy enabled AND
  reverseRewriteHostInResponseHeaders = False (so the OAuth redirect to Microsoft
  isn't rewritten to the site host).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReverseProxyToNextNode" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="http://127.0.0.1:3003{UNENCODED_URL}" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
